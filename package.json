{
  "name": "hygercard",
  "private": true,
  "type": "module",
  "description": "Blygger interaction-prototyping harness: HyperCard meets Xanadu's parallel streams",
  "scripts": {
    "dev": "vite --host",
    "build": "vite build",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p src/core/tsconfig.json --noEmit && tsc -p tsconfig.node.json --noEmit",
    "check:core": "bun test src/core/purity.test.ts",
    "test": "bun test",
    "test:browser": "vitest run",
    "snapshot": "bun scripts/snapshot.ts"
  },
  "dependencies": {
    "diff-match-patch": "^1.0.5",
    "dompurify": "^3.4.17",
    "fast-xml-parser": "^5.11.2",
    "htmlparser2": "^12.0.0",
    "leva": "^0.10.1",
    "markdown-it": "^15.0.3",
    "motion": "^14.7.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "@types/diff-match-patch": "^1.0.36",
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/browser": "^5.0.5",
    "@vitest/browser-playwright": "^5.0.5",
    "playwright": "^1.64.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
