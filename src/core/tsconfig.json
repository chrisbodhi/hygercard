{
  // The purity gate for src/core: no DOM lib, no Node types, so a reference to
  // `document`, `window`, `fetch`, `process` or `Buffer` fails to compile.
  // The two web-standard globals core does use (`crypto.getRandomValues`, `URL`)
  // are declared by hand in env.d.ts. Tests are checked by tsconfig.node.json.
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "types": [],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noFallthroughCasesInSwitch": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": ["./**/*.ts"],
  "exclude": ["./**/*.test.ts"]
}
